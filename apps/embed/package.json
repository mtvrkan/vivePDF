{
  "name": "@vivepdf/viewer",
  "private": true,
  "version": "0.1.0",
  "description": "A small, fast PDF viewer for any website: one <vive-pdf> tag, PDFium in WebAssembly, no server.",
  "keywords": ["pdf", "pdf-viewer", "viewer", "web-component", "custom-element", "pdfium", "webassembly"],
  "homepage": "https://vivepdf.com",
  "repository": { "type": "git", "url": "git+https://github.com/mtvrkan/vivePDF.git", "directory": "apps/embed" },
  "bugs": "https://github.com/mtvrkan/vivePDF/issues",
  "type": "module",
  "license": "MIT",
  "main": "./dist/vivepdf.mjs",
  "module": "./dist/vivepdf.mjs",
  "types": "./dist/types.d.ts",
  "unpkg": "./dist/vivepdf.js",
  "jsdelivr": "./dist/vivepdf.js",
  "exports": {
    ".": { "types": "./dist/types.d.ts", "default": "./dist/vivepdf.mjs" },
    "./vivepdf.js": "./dist/vivepdf.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "docs", "LICENSE", "THIRD-PARTY-NOTICES.txt", "README.md", "CHANGELOG.md"],
  "sideEffects": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode viewer && vite build --mode loader && tsc -p tsconfig.types.json",
    "bench:fixtures": "uv run --project ../../sidecar python bench/make_fixtures.py bench/fixtures",
    "bench": "node bench/run.mjs",
    "size": "node bench/size.mjs",
    "pack:zip": "pnpm build && node build/packZip.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-document-manager": "2.15.1",
    "@embedpdf/plugin-interaction-manager": "2.15.1",
    "@embedpdf/plugin-render": "2.15.1",
    "@embedpdf/plugin-rotate": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-search": "2.15.1",
    "@embedpdf/plugin-selection": "2.15.1",
    "@embedpdf/plugin-spread": "2.15.1",
    "@embedpdf/plugin-thumbnail": "2.15.1",
    "@embedpdf/plugin-tiling": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright-core": "1.64.1",
    "terser": "5.51.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "patchedDependencies": {
      "@embedpdf/engines@2.15.1": "patches/@embedpdf__engines@2.15.1.patch"
    }
  }
}
