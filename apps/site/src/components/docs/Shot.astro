---
type Props = { src: string; alt: string; caption?: string };
const { src, alt, caption } = Astro.props;
const base = `/shots/${src}`;
---
<figure class="d-shot">
  <a href={`${base}-1600.webp`} target="_blank" rel="noopener">
    <img
      src={`${base}-960.webp`}
      srcset={`${base}-960.webp 960w, ${base}-1600.webp 1600w`}
      sizes="(min-width: 960px) 760px, 100vw"
      width="1600"
      height="1000"
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
