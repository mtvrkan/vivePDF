---
import { APP_VERSION, docPath, LATEST_RELEASE_URL, type Locale } from "../../i18n";
import { HOME } from "../../i18n/home";
import { ANCHORS } from "../../i18n/ui";
import { docByKey } from "../../docs/structure";

type Props = { lang: Locale };
const { lang } = Astro.props;
const c = HOME[lang].download;
const buildHref = docPath(lang, docByKey("buildFromSource").slug[lang]);
const last = c.releases.length - 1;
---
<section class="sec dl-sec" id={ANCHORS[lang].download} aria-labelledby="dlTitle" style="padding-top:var(--s-6)">
  <div class="wrap dl-wrap">
    <div class="dl-stage glass" data-reveal>
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 class="dl-mega" id="dlTitle">vivePDF<span>{APP_VERSION}</span></h2>
      <p class="lead">{c.lead}</p>
      <div class="rel-wrap">
        <div class="rel-h"><p>{c.relTitle}</p><span>{c.relMeta}</span></div>
        <ol class="rel" id="rel">
          {c.releases.map((r, i) => <li class:list={{ now: i === last }}><time datetime={r.date}>{r.day}</time><b>{r.v}</b><span>{r.text}</span></li>)}
        </ol>
      </div>
      <div class="dl-cols" id="dlCols">
        <article class="dl-card">
          <div class="dl-top"><span class="os-mark"><svg aria-hidden="true"><use href="#i-win"/></svg></span><span class="ready"><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>{c.win.ready}</span></div>
          <div><h3>{c.win.title}</h3><p class="dl-file">{c.win.file}</p></div>
          <a class="btn btn-primary magnetic" href={LATEST_RELEASE_URL} style="align-self:flex-start"><svg class="ic" aria-hidden="true"><use href="#i-down"/></svg>{c.win.button}</a>
          <div class="smart">
            <p><strong>{c.win.smartStrong}</strong> {c.win.smartText}</p>
            <ol class="steps">{c.win.steps.map((s) => <li><span>{s}</span></li>)}</ol>
          </div>
          <p>{c.win.office}</p>
        </article>
        <article class="dl-card mac-card">
          <div class="os-row"><h3>{c.mac.title}</h3><span class="pending">{c.mac.pending}</span></div>
          <p class="mac-note">{c.mac.note}</p>
          <p>{c.mac.text}</p>
          <div class="term">
            <div class="term-bar"><p>Node 22 + pnpm · Rust · Python 3.12 + uv</p><button class="copy" type="button" id="copyBtn" data-copied={c.mac.copied} data-failed={c.mac.copyFailed}><svg class="ic" aria-hidden="true"><use href="#i-copy"/></svg><span>{c.mac.copy}</span></button></div>
<pre id="cmds"><span>$</span> cd apps/desktop &amp;&amp; pnpm install
<span>$</span> cd ../../sidecar &amp;&amp; uv sync
<span>$</span> cd ../apps/desktop &amp;&amp; pnpm tauri dev</pre>
          </div>
          <a class="text-link ul" href={buildHref}>{c.mac.build}<svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </article>
      </div>
    </div>
    <div class="gmark dl-mark" aria-hidden="true">
      <i class="glow"></i>
      <i class="gl"><svg><use href="#gm-l"/></svg></i>
      <i class="gr"><svg><use href="#gm-r"/></svg></i>
      <i class="gf"><svg><use href="#gm-f"/></svg></i>
    </div>
  </div>
</section>
