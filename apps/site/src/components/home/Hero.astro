---
import { APP_VERSION, MAC_DOWNLOAD_URL, WINDOWS_DOWNLOAD_URL, type Locale } from "../../i18n";
import { HOME } from "../../i18n/home";
import { ANCHORS } from "../../i18n/ui";

type Props = { lang: Locale };
const { lang } = Astro.props;
const c = HOME[lang].hero;
const a = ANCHORS[lang];
const proofIcons = [
  { cls: "pf-ok", icon: "i-sign" },
  { cls: undefined, icon: "i-scan" },
  { cls: "pf-amber", icon: "i-cloudoff" },
];
---
<section class="hero" aria-labelledby="heroTitle">
  <canvas class="hero-bg" id="heroBg" aria-hidden="true"></canvas>
  <canvas class="hero-gl" id="gl" aria-hidden="true"></canvas>
  <div class="gmark hero-mark" aria-hidden="true">
    <i class="glow"></i>
    <i class="gl"><svg><use href="#gm-l"/></svg></i>
    <i class="gr"><svg><use href="#gm-r"/></svg></i>
    <i class="gf"><svg><use href="#gm-f"/></svg></i>
  </div>
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-main">
        <a class="news" href={`#${a.present}`} data-hero><b>{APP_VERSION}</b><span>{c.news}</span><svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        <ul class="proof" aria-label={c.proofLabel} data-hero>
          {c.proof.map((p, i) => (
            <li><i class={proofIcons[i].cls}><svg class="ic" aria-hidden="true"><use href={`#${proofIcons[i].icon}`}/></svg></i><span><b>{p.b}</b><small>{p.small}</small></span>{i === 1 && <em aria-hidden="true"></em>}</li>
          ))}
        </ul>
        <h1 id="heroTitle" data-hero>{c.title.map((line) => <span class="ln"><span>{line}</span></span>)}</h1>
      </div>
      <div class="hero-side">
        <p class="lede" data-hero>{c.lede}</p>
        <div class="cta" data-hero>
          <a class="btn btn-primary magnetic" href={WINDOWS_DOWNLOAD_URL} referrerpolicy="no-referrer"><svg class="ic" aria-hidden="true"><use href="#i-win"/></svg>{c.windows}</a>
          <a class="btn btn-glass" href={MAC_DOWNLOAD_URL} referrerpolicy="no-referrer"><svg class="ic" aria-hidden="true"><use href="#i-apple"/></svg>{c.mac}</a>
          <ul class="facts" aria-label={c.factsLabel}>
            {c.facts.map((fact, i) => <li>{i === 0 && <span class="dot-ok" aria-hidden="true"></span>}{fact}</li>)}
          </ul>
        </div>
      </div>
    </div>
    <div class="hero-foot" data-hero>
      <p class="scroll-cue" aria-hidden="true"><i></i>{c.scroll}</p>
    </div>
  </div>
</section>
