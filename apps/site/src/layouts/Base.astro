---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/caveat/600.css";
import "../styles/tokens.css";
import "../styles/base.css";
import Sprite from "../components/Sprite.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { absoluteUrl, hreflangLinks, OG_LOCALE, type Alternates, type Locale } from "../i18n";
import { UI } from "../i18n/ui";

type Props = {
  lang: Locale;
  title: string;
  description: string;
  path: string;
  alternates: Alternates;
  ogImage?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown>[];
  navSolid?: boolean;
  hero?: boolean;
  noindex?: boolean;
};

const { lang, title, description, path, alternates, ogImage, ogType = "website", jsonLd = [], navSolid = false, hero = false, noindex = false } = Astro.props;
const ui = UI[lang];
const canonical = absoluteUrl(path);
const image = absoluteUrl(ogImage ?? `/og/${lang}.png`);
const links = hreflangLinks(alternates);
const otherLocales = (Object.keys(alternates) as Locale[]).filter((l) => l !== lang);
const ldJson = (data: Record<string, unknown>) => JSON.stringify(data).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang={lang} data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{links.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href}>)}
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#EAF2FB">
<meta property="og:site_name" content="vivePDF">
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content={OG_LOCALE[lang]}>
{otherLocales.map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]}>)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/icon-256.png">
<link rel="manifest" href="/site.webmanifest">
<script is:inline>(function(){var d=document.documentElement,t=new URLSearchParams(location.search).get("theme");if(t!=="dark"&&t!=="light"){try{t=localStorage.getItem("vp-theme")}catch(e){}}if(t!=="dark"&&t!=="light")t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";d.dataset.theme=t;if(t==="dark")document.querySelector('meta[name="theme-color"]').content="#060B15"})();</script>
<script is:inline>(function(){var s=new URLSearchParams(location.search).has("still")||matchMedia("(prefers-reduced-motion: reduce)").matches;document.documentElement.classList.add(s?"still":"motion")})();</script>
{jsonLd.map((data) => <script type="application/ld+json" set:html={ldJson(data)} />)}
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">{ui.skip}</a>
<Sprite />
<div class="atmo" aria-hidden="true"><i class="l1"></i><i class="l2"></i><i class="l3"></i></div>
<Nav lang={lang} alternates={alternates} solid={navSolid} hero={hero} />
<slot />
<Footer lang={lang} />
<slot name="after" />
<script>
  import "../scripts/site";
</script>
</body>
</html>
